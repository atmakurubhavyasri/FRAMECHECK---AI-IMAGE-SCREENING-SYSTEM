# Copy this file to .env and edit as needed.

# Path or Hugging Face model repository ID. The expanded TIGAS checkpoint is
# selected automatically when its model.safetensors is present; otherwise the
# backend uses the older local checkpoint or the public Hugging Face fallback.
# For explicit selection, uncomment this line:
# FRAMECHECK_HF_MODEL=models/framecheck-tigas-vit-large

# Indeterminate probability range for honest borderline results (UNCERTAIN)
# The selected model's colocated calibration_config.json supplies these values.
# Uncomment to override the checkpoint-specific band:
# FRAMECHECK_UNCERTAIN_LOW=0.48
# FRAMECHECK_UNCERTAIN_HIGH=0.52

# Comma-separated list of origins that may call the API directly during local
# development. Production uses Netlify's same-origin /api proxy.
FRAMECHECK_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080
